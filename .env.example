# 로컬 개발용: 복사해서 .env 로 저장 (git 제외). 배포 시에는 플랫폼 화면에서 환경변수로 넣는다.
DATABASE_URL=postgresql://user:password@localhost:5432/dashboard
PORT=8080
REDASH_URL=https://redash.example.com
REDASH_API_KEY=
REDASH_QUERY_ID=
# 앱 내 자동 수집: 기본 켜짐, 주기(분, 최소 5). 외부 스케줄러를 쓰면 AUTO_COLLECT=0
AUTO_COLLECT=1
COLLECT_INTERVAL_MIN=60

# AI 질문 기능 (ChatGPT API)
OPENAI_API_KEY=
OPENAI_MODEL=

# 접근 제어: 로컬 개발 때만 1 (로그인 헤더 없는 요청을 관리자로 취급). 배포 환경에는 넣지 않는다.
AUTH_DISABLED=
# 기본 관리자 추가(쉼표 구분). jmlee@barogo.com 은 코드에 고정.
ADMIN_EMAILS=
